# Backend (FastAPI + Messenger bot). Never commit the real .env.
OPENAI_API_KEY=your_openai_api_key_here
MODEL=gpt-4.1-nano
SUPABASE_URL=https://gzowslzdcvfpcqkncqtx.supabase.co/rest/v1/
# Supabase SECRET key (server only - never in the dashboard build)
SUPABASE_API_KEY=your_supabase_secret_key_here
PAGE_ACCESS_TOKEN=your_page_access_token_here
# Facebook App Secret: enables webhook signature verification (recommended)
MESSENGER_APP_SECRET=
# Optional; defaults to the previous verify token
MESSENGER_VERIFY_TOKEN=
# Comma-separated dashboard origins, e.g. https://your-dashboard.vercel.app,http://localhost:5173
CORS_ALLOW_ORIGINS=
CATALOG_TTL_SECONDS=60
