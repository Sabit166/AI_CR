# Backend (FastAPI + Discord bot). Never commit the real .env.
SUPABASE_URL=https://gzowslzdcvfpcqkncqtx.supabase.co/rest/v1/
# Supabase SECRET key (server only - never in the web app build)
SUPABASE_API_KEY=your_supabase_secret_key_here

# Discord Developer Portal -> your application
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Signs the private CR editor links that /manage sends (at least 32 random characters).
# Changing it invalidates every editor link already sent.
EDITOR_LINK_SECRET=
# How long an editor link works (hours, default 12)
EDITOR_LINK_HOURS=12
# Where the web app is deployed; used to build the links the bot sends
SITE_URL=https://ai-cr-three.vercel.app

# Automatic posts, Asia/Dhaka time (defaults shown). SCHEDULER_ENABLED=0 turns them off.
WEEKLY_UPDATE_TIME=18:00
EXAM_REMINDER_TIME=20:00
SCHEDULER_ENABLED=1
# Optional: lets an external cron call POST /cron/tick with header X-Cron-Secret
CRON_SECRET=

# Comma-separated web app origins, e.g. https://your-site.vercel.app,http://localhost:5173
CORS_ALLOW_ORIGINS=
CATALOG_TTL_SECONDS=60
